{
  "name": "stocks-analytics-engine",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node index.js && node visualizer-report.js && node visualizer-analytics.js && node server/serveReport.js",
    "analytics": "node visualizer-analytics.js",
    "report": "node visualizer-report.js",
    "analytics:serve": "node visualizer-analytics.js --serve",
    "screen-rut": "node --use-system-ca --experimental-specifier-resolution=node scripts/screenIndex.js rut",
    "screen-dji": "node --use-system-ca --experimental-specifier-resolution=node scripts/screenIndex.js dji",
    "screen-ndx": "node --use-system-ca --experimental-specifier-resolution=node scripts/screenIndex.js ndx",
    "screen-sp100": "node --use-system-ca --experimental-specifier-resolution=node scripts/screenIndex.js sp100",
    "screen-all": "node --use-system-ca --experimental-specifier-resolution=node scripts/screenIndex.js all",
    "setup": "node scripts/createWorkbook.js && node --use-system-ca --experimental-specifier-resolution=node scripts/screenIndex.js all",
    "clean-workbook": "node scripts/cleanWorkbook.js && node --use-system-ca --experimental-specifier-resolution=node scripts/cleanWorkbook.js all",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "visualize": "node --use-system-ca visualizer.js",
    "visualize:serve": "node --use-system-ca visualizer.js --serve",
    "visualize-report": "node --use-system-ca visualizer-report.js",
    "visualize-report:serve": "node --use-system-ca visualizer-report.js --serve",
    "build:report": "node --use-system-ca visualizer-report.js",
    "build:analytics": "node --use-system-ca visualizer-analytics.js",
    "build:nightly": "node scripts/createWorkbook.js && node --experimental-specifier-resolution=node index.js && npm run build:report && npm run build:analytics && cp data/report.html data/index.html"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@stonksjs/finviz": "^3.0.1",
    "axios": "^1.15.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dayjs": "^1.11.20",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "firebase": "^12.13.0",
    "firebase-admin": "^14.0.0",
    "helmet": "^8.2.0",
    "morgan": "^1.11.0",
    "simple-statistics": "^7.8.9",
    "yahoo-finance2": "^3.14.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0"
  }
}
